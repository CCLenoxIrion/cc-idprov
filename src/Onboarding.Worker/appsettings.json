{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Onboarding": "Data Source=onboarding.db"
  },
  "Integrations": {
    "Mode": "Fake"
  },
  "SecretProtection": {
    "Mode": "Certificate"
  },
  "Worker": {
    "MaxParallelRequests": 4,
    "ExecutionTimeout": "00:05:00"
  },
  "FakeWorld": {
    "EntraUserDelayChecks": 1,
    "LicenseDelayChecks": 1,
    "MailboxDelayChecks": 1,
    "TeamsUserDelayChecks": 2,
    "EnabledDelayChecks": 1,
    "FreeLicenses": { "SPB": 10, "MCOEV": 10 },
    "ExistingSamAccountNames": [],
    "Faults": []
  }
}
