@page "/requests/new"
@page "/requests/{Id:guid}/edit"
@attribute [Authorize(Policy = Policies.Requester)]
@inherits OnboardingComponentBase
@inject RequestService Requests
@inject NavigationManager Navigation

<PageTitle>Auftrag</PageTitle>
<h1>@(Id is null ? "Neuer Onboarding-Auftrag" : "Entwurf bearbeiten")</h1>

<Messages Error="@Error" Info="@Info" />

@if (_context is null)
{
    <p>Lädt …</p>
    return;
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="row g-2">
            <div class="col-md-5">
                <label class="form-label">Vorname *</label>
                <input class="form-control" @bind="_input.FirstName" @bind:after="NameChangedAsync" />
            </div>
            <div class="col-md-5">
                <label class="form-label">Nachname *</label>
                <input class="form-control" @bind="_input.LastName" @bind:after="NameChangedAsync" />
            </div>
            <div class="col-md-2 pt-4">
                <div class="form-check mt-2">
                    <input class="form-check-input" type="checkbox" id="doctor" @bind="_input.HasDoctorTitle" @bind:after="PreviewAsync" />
                    <label class="form-check-label" for="doctor">Dr.</label>
                </div>
            </div>

            <div class="col-md-8">
                <label class="form-label">E-Mail *</label>
                <input class="form-control" @bind="_input.Mail" @bind:after="MailEditedAsync" />
                <div class="form-text">Wird aus dem Namen vorbelegt und kann geändert werden.</div>
            </div>
            <div class="col-md-4">
                <label class="form-label">Typ</label>
                <select class="form-select" disabled>
                    <option>Onboarding</option>
                </select>
            </div>

            <div class="col-12">
                <label class="form-label d-block">Bereich *</label>
                @foreach (var area in _context.Areas)
                {
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="area" id="area-@area.Id"
                               checked="@(_input.AreaId == area.Id)" @onchange="() => SelectAreaAsync(area.Id)" />
                        <label class="form-check-label" for="area-@area.Id">@area.Name</label>
                    </div>
                }
            </div>

            <div class="col-md-6">
                <label class="form-label">Abteilung *</label>
                <select class="form-select" @bind="_input.DepartmentId" @bind:after="PreviewAsync">
                    <option value="@Guid.Empty">– wählen –</option>
                    @foreach (var d in _context.Departments)
                    {
                        <option value="@d.Id">@d.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Eintrittsdatum *</label>
                <input class="form-control" type="date" @bind="_date" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Durchwahl</label>
                <input class="form-control" inputmode="numeric" maxlength="4" @bind="_input.Extension" @bind:after="PreviewAsync" />
            </div>

            <div class="col-12">
                <label class="form-label">Vorgesetzte(r) *</label>
                @if (_manager is not null)
                {
                    <div class="mb-1">
                        <span class="badge bg-light text-dark border fs-6">@_manager.DisplayName</span>
                        <button class="btn btn-sm btn-link" @onclick="() => { _manager = null; _input.ManagerObjectGuid = Guid.Empty; }">ändern</button>
                    </div>
                }
                else
                {
                    <div class="input-group">
                        <input class="form-control" placeholder="Name im Verzeichnis suchen" @bind="_managerQuery" @bind:after="SearchManagerAsync" />
                        <button class="btn btn-outline-secondary" @onclick="SearchManagerAsync">Suchen</button>
                    </div>
                    @if (_managerResults.Count > 0)
                    {
                        <div class="list-group mt-1">
                            @foreach (var user in _managerResults)
                            {
                                <button class="list-group-item list-group-item-action" @onclick="() => SelectManager(user)">
                                    @user.DisplayName <small class="text-muted">@user.Mail</small>
                                </button>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        @if (_errors.Count > 0)
        {
            <div class="alert alert-danger mt-3">
                <ul class="mb-0">
                    @foreach (var e in _errors)
                    {
                        <li>@e</li>
                    }
                </ul>
            </div>
        }

        <div class="mt-3">
            <button class="btn btn-primary" disabled="@Busy" @onclick="() => SaveAsync(submit: true)">Einreichen</button>
            <button class="btn btn-outline-secondary" disabled="@Busy" @onclick="() => SaveAsync(submit: false)">Als Entwurf speichern</button>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card">
            <div class="card-body">
                <h2 class="h6">Vorschau abgeleiteter Werte</h2>
                @if (_preview?.Identity is { } id)
                {
                    <dl class="row small mb-0">
                        <dt class="col-5">sAMAccountName</dt><dd class="col-7 font-monospace">@id.SamAccountName</dd>
                        <dt class="col-5">UPN</dt><dd class="col-7 font-monospace">@id.UserPrincipalName</dd>
                        <dt class="col-5">proxyAddresses</dt><dd class="col-7 font-monospace">@foreach (var p in id.ProxyAddresses)
                        {
                            <div>@p</div>
                        }</dd>
                        <dt class="col-5">company</dt><dd class="col-7">@id.Company</dd>
                        <dt class="col-5">OU</dt><dd class="col-7 font-monospace small">@id.OuDistinguishedName</dd>
                        <dt class="col-5">Anmeldeskript</dt><dd class="col-7 font-monospace">@id.ScriptPath</dd>
                        <dt class="col-5">Telefon</dt><dd class="col-7 font-monospace">@(id.TelephoneNumber ?? "–")</dd>
                        <dt class="col-5">E.164</dt><dd class="col-7 font-monospace">@(id.PhoneE164 ?? "–")</dd>
                        @foreach (var (attrName, attrValue) in id.AdditionalAttributes)
                        {
                            <dt class="col-5">@attrName</dt><dd class="col-7">@attrValue</dd>
                        }
                    </dl>
                }
                @if (_preview is not null)
                {
                    @foreach (var issue in _preview.Issues)
                    {
                        <div class="alert alert-warning small py-1 mt-2 mb-1">@issue.Message</div>
                    }
                    @if (_preview.Issues.Any(i => i.Code != IdentityIssueCode.InvalidExtension))
                    {
                        <div class="small text-muted">Der Auftrag kann trotzdem eingereicht werden; ein ITAdmin vergibt die Werte dann manuell (NeedsInput).</div>
                    }
                    @foreach (var warning in _preview.Warnings)
                    {
                        <div class="alert alert-info small py-1 mt-2 mb-1">@warning</div>
                    }
                    @if (_preview.Licenses.Count > 0)
                    {
                        <h3 class="h6 mt-3">Lizenzen</h3>
                        <table class="table table-sm small mb-0">
                            @foreach (var l in _preview.Licenses)
                            {
                                <tr class="@(l.Free is <= 0 ? "table-danger" : "")">
                                    <td>@l.SkuPartNumber</td><td>@(l.Free?.ToString() ?? "unbekannt") frei</td>
                                </tr>
                            }
                        </table>
                    }
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public Guid? Id { get; set; }

    private FormContext? _context;
    private PersonInput _input = new();
    private DateOnly? _date;
    private bool _mailEdited;
    private string _managerQuery = "";
    private IReadOnlyList<Onboarding.Core.Directory.DirectoryUser> _managerResults = [];
    private Onboarding.Core.Directory.DirectoryUser? _manager;
    private FormPreview? _preview;
    private List<string> _errors = [];

    protected override async Task OnInitializedAsync()
    {
        _context = await Requests.GetFormContextAsync();
        if (Id is { } id)
        {
            var details = await Requests.GetDetailsAsync(id);
            if (details is null || details.Request.Status != RequestStatus.Draft)
            {
                Error = "Nur Entwürfe können bearbeitet werden.";
                _context = null;
                return;
            }

            var i = details.Request.Input;
            _input = new PersonInput
            {
                FirstName = i.FirstName, LastName = i.LastName, HasDoctorTitle = i.HasDoctorTitle, Mail = i.Mail,
                AreaId = i.AreaId, DepartmentId = i.DepartmentId, ManagerObjectGuid = i.ManagerObjectGuid,
                EffectiveDate = i.EffectiveDate, Extension = i.Extension,
            };
            _date = i.EffectiveDate;
            _manager = details.Manager;
            _mailEdited = true;
            await PreviewAsync();
        }
    }

    private async Task NameChangedAsync()
    {
        if (!_mailEdited)
        {
            _input.Mail = IdentityDeriver.SuggestMail(_input.FirstName, _input.LastName, _context!.Global) ?? "";
        }

        await PreviewAsync();
    }

    private async Task MailEditedAsync()
    {
        var suggestion = IdentityDeriver.SuggestMail(_input.FirstName, _input.LastName, _context!.Global);
        _mailEdited = !string.Equals(_input.Mail, suggestion, StringComparison.OrdinalIgnoreCase);
        await PreviewAsync();
    }

    private async Task SelectAreaAsync(Guid id)
    {
        _input.AreaId = id;
        await PreviewAsync();
    }

    private async Task SearchManagerAsync() =>
        _managerResults = string.IsNullOrWhiteSpace(_managerQuery) ? [] : await Requests.SearchManagersAsync(_managerQuery);

    private void SelectManager(Onboarding.Core.Directory.DirectoryUser user)
    {
        _manager = user;
        _input.ManagerObjectGuid = user.ObjectGuid;
        _managerResults = [];
        _managerQuery = "";
    }

    private async Task PreviewAsync()
    {
        if (string.IsNullOrWhiteSpace(_input.FirstName) || string.IsNullOrWhiteSpace(_input.LastName))
        {
            _preview = null;
            return;
        }

        await RunAsync(async () => _preview = await Requests.PreviewAsync(Id, _input));
    }

    private List<string> Validate()
    {
        var errors = new List<string>();
        if (string.IsNullOrWhiteSpace(_input.FirstName) || string.IsNullOrWhiteSpace(_input.LastName))
        {
            errors.Add("Vor- und Nachname sind Pflichtfelder.");
        }

        if (string.IsNullOrWhiteSpace(_input.Mail))
        {
            errors.Add("E-Mail ist ein Pflichtfeld.");
        }
        else if (IdentityValidator.ValidateMail(_input.Mail.Trim().ToLowerInvariant()) is { } mailError)
        {
            errors.Add(mailError);
        }

        if (_input.AreaId == Guid.Empty)
        {
            errors.Add("Bitte genau einen Bereich wählen.");
        }

        if (_input.DepartmentId == Guid.Empty)
        {
            errors.Add("Bitte eine Abteilung wählen.");
        }

        if (_input.ManagerObjectGuid == Guid.Empty)
        {
            errors.Add("Bitte Vorgesetzte(n) aus dem Verzeichnis wählen.");
        }

        if (_date is null)
        {
            errors.Add("Eintrittsdatum ist ein Pflichtfeld.");
        }

        if (IdentityValidator.ValidateExtension(_input.Extension?.Trim()) is { } extensionError)
        {
            errors.Add(extensionError);
        }

        // "nicht bereits vergeben" (SPEC §2) blocks; other collisions are resolved by an ITAdmin.
        if (_preview?.Issues.Any(i => i.CollisionField == CollisionField.PhoneNumber) == true)
        {
            errors.Add("Die Durchwahl ist bereits vergeben.");
        }

        return errors;
    }

    private async Task SaveAsync(bool submit)
    {
        await PreviewAsync();
        _errors = Validate();
        if (_errors.Count > 0)
        {
            return;
        }

        _input.EffectiveDate = _date!.Value;
        _input.Mail = _input.Mail.Trim().ToLowerInvariant();
        _input.Extension = string.IsNullOrWhiteSpace(_input.Extension) ? null : _input.Extension.Trim();
        Guid? id = Id;
        var ok = await RunAsync(async () =>
        {
            if (Id is { } existing)
            {
                await Requests.UpdateDraftAsync(existing, _input, submit);
            }
            else
            {
                id = await Requests.CreateAsync(_input, submit);
            }
        });
        if (ok)
        {
            Navigation.NavigateTo($"requests/{id}");
        }
    }
}
