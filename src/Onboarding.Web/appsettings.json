      },
      "Ldap": {
        "Server": "",
        "Port": 389,
        "Timeout": "00:00:15",
        "PageSize": 500
      }
    },
    "FakeDataFile": "DevData/fake-directory.json"
  },
  "SecretProtection": {
    "Mode": "Certificate"
  }
