root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets,slnx,json,razor}]
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

# Windows PowerShell 5.1 (JEA endpoints) reads files without BOM as ANSI: umlauts would break.
[scripts/**.{ps1,psm1,psd1,psrc,template}]
indent_size = 4
charset = utf-8-bom
end_of_line = crlf

# EF Core migrations are generated code.
[src/Onboarding.Data/Migrations/*.cs]
generated_code = true
